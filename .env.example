# Copy to .env and replace every placeholder. Never commit .env.
POSTGRES_DB=health_dashboard
POSTGRES_USER=health
POSTGRES_PASSWORD=replace-with-a-unique-database-password
DATABASE_URL=postgresql+psycopg://health:replace-with-a-unique-database-password@db:5432/health_dashboard
INGEST_API_TOKEN=replace-with-a-long-random-token
ADMIN_TOKEN=
APP_TIMEZONE=UTC
SESSION_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:3016,http://127.0.0.1:3016
API_HOST_PORT=8015
FRONTEND_HOST_PORT=3016
VITE_API_BASE_URL=
VITE_PUBLIC_API_BASE_URL=http://localhost:3016
CLOUDFLARED_TOKEN=
