<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_rings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_nutrition_background"
    android:layoutDirection="ltr"
    android:padding="6dp"
    android:textDirection="ltr">

    <ImageView
        android:id="@+id/widget_rings_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:contentDescription="@string/nutrition_rings_widget_description"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_rings_kcal"
            android:layout_width="34dp"
            android:layout_height="18dp"
            android:gravity="center"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeMaxTextSize="13sp"
            android:fontFamily="sans"
            android:includeFontPadding="false"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:textDirection="ltr"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_rings_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans"
            android:includeFontPadding="false"
            android:text="kcal"
            android:textColor="#73DF8D"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
