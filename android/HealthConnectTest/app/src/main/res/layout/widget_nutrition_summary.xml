<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_nutrition_background" android:layoutDirection="ltr"
    android:textDirection="ltr" android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingHorizontal="16dp" android:paddingVertical="8dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.4"
        android:orientation="vertical" android:paddingEnd="14dp">
        <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="CALORIES" android:textSize="9sp" android:textStyle="bold" android:includeFontPadding="false"
            android:textColor="@color/widget_muted" />
        <TextView android:id="@+id/widget_calories_value" android:layout_width="match_parent" android:layout_height="28dp"
            android:text="0" android:textSize="24sp" android:textStyle="bold" android:includeFontPadding="false"
            android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="14sp"
            android:autoSizeMaxTextSize="24sp" android:textColor="@color/widget_foreground" />
        <TextView android:id="@+id/widget_calories_label" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="of 2,200 kcal" android:textSize="9sp" android:includeFontPadding="false"
            android:maxLines="1" android:textColor="@color/widget_muted" />
        <ProgressBar android:id="@+id/widget_calories_progress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="5dp"
            android:progressDrawable="@drawable/widget_progress_calories" android:max="100" android:progress="0" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:paddingEnd="12dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="PROTEIN" android:textSize="9sp" android:textStyle="bold" android:includeFontPadding="false"
            android:textColor="@color/widget_muted" />
        <TextView android:id="@+id/widget_protein_value" android:layout_width="match_parent" android:layout_height="28dp"
            android:text="0 g" android:textSize="20sp" android:textStyle="bold" android:includeFontPadding="false"
            android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="20sp" android:textColor="@color/widget_foreground" />
        <TextView android:id="@+id/widget_protein_goal" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="of 140 g" android:textSize="9sp" android:includeFontPadding="false" android:maxLines="1"
            android:textColor="@color/widget_muted" />
        <ProgressBar android:id="@+id/widget_protein_progress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="5dp"
            android:progressDrawable="@drawable/widget_progress_protein" android:max="100" android:progress="0" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="FIBER" android:textSize="9sp" android:textStyle="bold" android:includeFontPadding="false"
            android:textColor="@color/widget_muted" />
        <TextView android:id="@+id/widget_fiber_value" android:layout_width="match_parent" android:layout_height="28dp"
            android:text="0 g" android:textSize="20sp" android:textStyle="bold" android:includeFontPadding="false"
            android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="20sp" android:textColor="@color/widget_foreground" />
        <TextView android:id="@+id/widget_fiber_goal" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="of 30 g" android:textSize="9sp" android:includeFontPadding="false" android:maxLines="1"
            android:textColor="@color/widget_muted" />
        <ProgressBar android:id="@+id/widget_fiber_progress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="5dp"
            android:progressDrawable="@drawable/widget_progress_fiber" android:max="100" android:progress="0" />
    </LinearLayout>
</LinearLayout>
